dingColor":"3D-rakennusten v\xE4ri",backgroundColor:"Taustav\xE4ri"},effectManager:{effects:"Efektit",addEffect:"Lis\xE4\xE4 efekti",pickDateTime:"Valitse p\xE4iv\xE4m\xE4\xE4r\xE4/aika",currentTime:"Nykyinen aika",pickCurrrentTime:"Valitse nykyinen aika",date:"P\xE4iv\xE4m\xE4\xE4r\xE4",time:"Aika",timezone:"Aikavy\xF6hyke"},annotationManager:{title:"Merkinn\xE4t",addAnnotation:"Lis\xE4\xE4",type:"Tyyppi",lineWidth:"Viivan leveys",color:"V\xE4ri",textSide:"Tekstin puoli",textPlacement:"Sijoittelu"},effectDescription:{lightAndShadow:"Simuloi realistista auringonvaloa ja varjojen heijastusta vuorokaudenajan ja maantieteellisen sijainnin perusteella. S\xE4\xE4dett\xE4v\xE4 varjon voimakkuus, auringon- ja ymp\xE4rist\xF6valon v\xE4rit.",ink:"K\xE4ytt\xE4\xE4 mustepesumaista taiteellista tyyli\xE4, joka tummentaa reunoja ja luo k\xE4sin piirretyn ulkoasun. S\xE4\xE4d\xE4 voimakkuutta tehon hallitsemiseksi.",brightnessContrast:"S\xE4\xE4t\xE4\xE4 kartan yleist\xE4 kirkkautta ja kontrastia. K\xE4yt\xE4 positiivisia arvoja kirkastaaksesi tai lis\xE4t\xE4ksesi kontrastia, negatiivisia arvoja tummentaaksesi tai tasoittaaksesi kuvaa.",hueSaturation:"Siirt\xE4\xE4 v\xE4ris\xE4vy\xE4 ja s\xE4\xE4t\xE4\xE4 kyll\xE4isyytt\xE4 koko kartalla. Hy\xF6dyllinen v\xE4riteemojen luomiseen tai n\xE4kym\xE4n v\xE4rikyll\xE4isyyden v\xE4hent\xE4miseen.",vibrance:"Nostaa valikoivasti himeiden v\xE4rien voimakkuutta ylikyll\xE4st\xE4m\xE4tt\xE4 jo el\xE4vi\xE4 v\xE4rej\xE4. Tuottaa luonnollisemman n\xE4k\xF6isen v\xE4rinparannuksen kuin kyll\xE4isyys.",sepia:"K\xE4ytt\xE4\xE4 l\xE4mmint\xE4 ruskeaa s\xE4vy\xE4, joka muistuttaa vanhoja valokuvia. Hallitse m\xE4\xE4r\xE4\xE4 sekoittaaksesi alkuper\xE4isten v\xE4rien ja seepiamaisen ulkoasun v\xE4lill\xE4.",dotScreen:"Muuntaa kuvan mustavalkoisten pisteiden kuvioksi, joka muistuttaa sanomalehtien rasteripainatusta. S\xE4\xE4d\xE4 kulmaa, pisteen kokoa ja keskikohtaa.",colorHalftone:"Simuloi CMYK-v\xE4rirasteripinatusta erillisill\xE4 pistekuvioilla kullekin v\xE4rikanavalle. Hallitse kulmaa, pisteen kokoa ja keskikohtaa.",noise:"Lis\xE4\xE4 satunnaista filmirakeista kohinaa kartalle. Hy\xF6dyllinen teksturoidun, analogisen estetiikan luomiseen tai v\xE4riporrastuksen v\xE4hent\xE4miseen.",triangleBlur:"K\xE4ytt\xE4\xE4 tasaista gaussimaista sumennusta tasaisesti kartalla. Hallitse sumennuksen s\xE4dett\xE4 pehmeyden tason s\xE4\xE4t\xE4miseksi.",zoomBlur:"Luo s\xE4teitt\xE4isen liikesumennuksen, joka l\xE4htee keskipisteest\xE4 simuloiden kamerazoomia. S\xE4\xE4d\xE4 voimakkuutta ja keskikohtaa.",tiltShift:"Simuloi tilt-shift-linssitehostetta, joka sumentaa tarkennuskaistan ulkopuoliset alueet luoden pienoismallimaisen ulkoasun. Aseta tarkennuskaista alku-/loppukohdilla.",edgeWork:"Korostaa kuvan rakenteellisia reunoja taiteellisella hiilipiirrostyylill\xE4. S\xE4\xE4d\xE4 tunnistuss\xE4dett\xE4 viivan paksuuden hallitsemiseksi.",vignette:"Tummentaa kartan kulmat ja reunat ohjaten huomion keskelle. Hallitse tummentamisen m\xE4\xE4r\xE4\xE4 ja kirkkaan alueen s\xE4dett\xE4.",magnify:"Luo py\xF6re\xE4n suurennuslasin peiton asetettavaan kohtaan. S\xE4\xE4d\xE4 kokoa, zoomaustasoa ja reunuksen leveytt\xE4.",hexagonalPixelate:"Korvaa kuvan heksagonaalisten laattojen ruudukolla, joista kukin on t\xE4ytetty kattamansa alueen keskiv\xE4rill\xE4. S\xE4\xE4d\xE4 laatan mittakaavaa.",distanceFog:"H\xE4ivytt\xE4\xE4 kaukaisia kohteita sumuv\xE4riksi niiden syvyyden perusteella kamerasta, tehostamalla syvyysvaikutelmaa. Hallitse tiheytt\xE4, alkuet\xE4isyytt\xE4, aluetta ja sumun v\xE4ri\xE4.",surfaceFog:"Render\xF6i sumukerroksen tietyll\xE4 korkeudella maanpinnan yl\xE4puolella. S\xE4\xE4d\xE4 korkeutta, siirtym\xE4n paksuutta, tiheytt\xE4, v\xE4ri\xE4 ja valinnaista kohinakuviota."},layerConfiguration:{defaultDescription:"Laske suureen {property} arvo valitun kent\xE4n perusteella",howTo:"Miten toimii",showColorChart:"N\xE4yt\xE4 v\xE4rikartta",hideColorChart:"Piilota v\xE4rikartta"},filterManager:{addFilter:"Lis\x