  display: grid;
  grid-template-columns: minmax(72px, 40%) 1fr;
  align-items: center;
  row-gap: 4px;
  column-gap: 6px;
  margin-bottom: 4px;

  .item-selector {
    height: 28px;
  }
  .item-selector__dropdown {
    height: 26px;
  }
  .side-panel-panel__label {
    line-height: 16px;
    margin-bottom: 0;
  }
  .side-panel-section {
    margin-bottom: 0;
  }
  input {
    height: 28px;
