}

vec4 edgeWork_sampleColorXY(sampler2D source, vec2 texSize, vec2 texCoord, vec2 delta) {
  vec2 relativeDelta = edgeWork.radius * delta / texSize;

  vec2 color = vec2(0.0);
  vec2 total = vec2(0.0);

