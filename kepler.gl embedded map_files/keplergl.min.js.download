  display: flex;
  font-size: ${e=>e.theme.cellFontSize}px;
  flex-grow: 1;
  color: ${e=>e.theme.dataTableTextColor};
  width: 100%;
  position: relative;
  .ReactVirtualized__Grid:focus,
  .ReactVirtualized__Grid:active {
    outline: 0;
  }
  .body-grid {
    ${e=>e.$hasCustomScrollBarStyle&&e.theme.modalScrollBar}
  }

  .cell {
    &::-webkit-scrollbar {
      display: none;
    }
  }

  *:focus {
    outline: 0;
  }

  .results-table-wrapper {
    position: relative;
    min-height: 100%;
    max-height: 100%;
    display: flex;
    flex-direction: row;
    flex-grow: 1;
    overflow: hidden;

    .scroll-in-ui-thread.pinned-columns--header {
      overflow: hidden;
      border-bottom: 1px solid ${e=>e.theme.cellBorderColor};
      padding-bottom: ${wOr}px;
    }
    .scroll-in-ui-thread.unpinned-columns--header {
      width: 100vw;
      overflow: hidden;
      border-bottom: 1px solid ${e=>e.theme.cellBorderColor};
      // leave room for scrollbar
      padding-bottom: ${wOr}px;
    }

    .scroll-in-ui-thread::after {
      content: '';
      height: 100%;
      left: 0;
      position: absolute;
      pointer-events: none;
      top: 0;
      width: 100%;
    }

    .grid-row {
      position: relative;
      display: flex;
      flex-direction: row;
    }
    .grid-column {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
    }
    .pinned-grid-container {
      flex: 0 0 75px;
      z-index: 10;
      position: absolute;
      left: 0;
      top: 0;
      border-right: 2px solid ${e=>e.theme.pinnedGridBorderColor};
    }
    .even-row {
      background-color: ${e=>e.theme.evenRowBackground};
    }
    .odd-row {
      background-color: ${e=>e.theme.oddRowBackground};
    }
    .cell,
    .header-cell {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      text-align: center;
      overflow: hidden;
      // header border is rendered by header container
      border-bottom: 0;
      .n-sort-idx {
        font-size: 9px;
      }
    }
    .cell {
      justify-content: center;
      align-items: flex-start;
      border-bottom: 1px solid ${e=>e.theme.cellBorderColor};
      border-right: 1px solid ${e=>e.theme.cellBorderColor};
      white-space: nowrap;
      overflow: auto;
      padding: 0 ${e=>e.theme.cellPaddingSide}px;
      font-size: ${e=>e.theme.cellFontSize}px;

      .result-link {
        text-decoration: none;
      }
    }
    .header-cell {
      justify-content: ${e=>e.$hasStats?"flex-start":"center"};
      align-items: ${e=>e.$hasStats?"stretch":"flex-start"};
    }
    .cell.end-cell {
      border-right: none;
      padding-right: ${e=>e.theme.cellPaddingSide+e.theme.edgeCellPaddingSide}px;
    }
    .header-cell.end-cell {
      border-right: ${e=>e.$hasStats?`1px solid ${e.theme.cellBorderColor}`:"none"};
      padding-right: ${e=>e.$hasStats?0:e.theme.cellPaddingSide+e.theme.edgeCellPaddingSide}px;
    }
    .cell.first-cell {
      padding-left: ${e=>e.theme.cellPaddingSide+e.theme.edgeCellPaddingSide}px;
    }
    .header-cell.first-cell {
      padding-left: ${e=>e.$hasStats?0:e.theme.cellPaddingSide+e.theme.edgeCellPaddingSide}px;
    }
    .cell.bottom-cell {
      border-bottom: none;
    }
    .cell.align-right {
      align-items: flex-end;
    }
  }

  &:focus {
    outline: none;
