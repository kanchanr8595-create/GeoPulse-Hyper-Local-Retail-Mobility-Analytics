    : 1.0;
  float visibility = 1.0 - depthFactor;
  vec3 transmission = pow(vec3(visibility), vec3(3.6, 1.6, 1.0) / max(abs(V.z), 0.2));
  vec3 scattering = fogColorNorm * mix(vec3(0.85, 1.05, 1.1),
