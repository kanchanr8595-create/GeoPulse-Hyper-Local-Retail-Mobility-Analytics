    fill: ${e=>e.theme.primaryBtnActBgd} !important;
  }
  #deck-canvas::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 20px;
    height: 20px;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 1;
