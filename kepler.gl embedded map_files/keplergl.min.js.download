  display: flex;
  flex-direction: column;

  max-width: ${OKs}px;
  max-height: ${LKs}px;
  padding: 14px;
  & > * + * {
    margin-top: 6px;
  }
  ${e=>e.theme.scrollBar};
  font-family: ${e=>e.theme.fontFamily};
  font-size: 11px;
  font-weight: 500;
  background-color: ${e=>e.theme.panelBackground};
  color: ${e=>e.theme.textColor};
  z-index: 98; /* should be below 99 which is side pane */
  overflow-x: auto;
  box-shadow: ${e=>e.theme.panelBoxShadow};

  &:hover {
    background-color: ${e=>`${e.theme.panelBackground}`};
  }

  .primary-label {
    color: ${e=>e.theme.notificationColors.success};
    font-size: 10px;
  }

  .map-popover__layer-info,
  .coordingate-hover-info {
    & > * + * {
      margin-top: 7px;
    }
  }

  table {
    width: auto;
    display: grid;
    border-collapse: collapse;
    row-gap: 5px;
    column-gap: 5px;
  }

  .coordingate-hover-info > table {
    grid-template-columns: auto auto auto;
  }
  .map-popover__layer-info > table {
    grid-template-columns: auto auto;
  }
  .map-popover__layer-info > table.comparing,
  .map-popover__layer-info > table.donut {
    grid-template-columns: auto auto auto;
  }

  .map-popover__layer-info > table.donut {
    td[colspan='2'] {
      grid-column: span 2;
    }
    td[colspan='3'] {
      grid-column: 1 / -1;
    }
  }

  tbody,
  tr {
    display: contents;
  }

  td {
    border-color: transparent;
    color: ${e=>e.theme.textColor};
  }

  td.row__value {
    text-align: right;
    font-weight: 500;
    color: ${e=>e.theme.textColorHl};
  }
