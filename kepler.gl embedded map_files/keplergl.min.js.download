 Incremental",animationByInterval:"Pas per interval",speed:"velocitat",play:"iniciar",pause:"pausar",reset:"reiniciar",export:"exportar",timeLayerSync:"Vincula amb la l\xEDnia de temps de la capa",timeLayerUnsync:"Desvincula de la l\xEDnia de temps de la capa",syncTimelineStart:"Inici del per\xEDode de temps del filtre actual",syncTimelineEnd:"Fi del per\xEDode de temps del filtre actual",showEffectPanel:"Mostra el panell d'efectes",hideEffectPanel:"Amaga el panell d'efectes",showChartPanel:"Mostra els gr\xE0fics",hideChartPanel:"Amaga els gr\xE0fics",showAnnotationPanel:"Mostra les anotacions",hideAnnotationPanel:"Amaga les anotacions",removeAnnotation:"Elimina l'anotaci\xF3",duplicateAnnotation:"Duplica l'anotaci\xF3",hideAnnotation:"Amaga l'anotaci\xF3",showAnnotation:"Mostra l'anotaci\xF3",annotationSettings:"Configuraci\xF3 de l'anotaci\xF3",removeEffect:"Elimina l'efecte",disableEffect:"Desactiva l'efecte",effectSettings:"Configuraci\xF3 de l'efecte",editLayerJson:"Edita JSON de la capa",editFilterJson:"Edita JSON del filtre",editEffectJson:"Edita JSON de l'efecte",editViewportJson:"Edita JSON de la vista",editAnimationJson:"Edita JSON de l'animaci\xF3",editChartJson:"Edita JSON del gr\xE0fic"},toolbar:{exportImage:"Exporta imatge",exportData:"Exporta dades",exportMap:"Exporta mapa",exportVideo:"Exporta V\xEDdeo",shareMapURL:"Comparteix URL del mapa",saveMap:"Desa mapa",select:"selecciona",point:"punt",line:"l\xEDnia",polygon:"pol\xEDgon",rectangle:"rectangle",circle:"cercle",copyAll:"Copia-ho tot",convertToLayer:`Converteix
